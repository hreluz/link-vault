# Supabase — https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# YouTube Data API v3 — https://console.cloud.google.com/apis/library/youtube.googleapis.com
# Optional: enables video duration fetching for YouTube links (free tier: 10,000 units/day)
YOUTUBE_API_KEY=your-youtube-data-api-v3-key

# Admin role — server-only, no NEXT_PUBLIC_ prefix.
# Accounts created with this email are assigned the 'admin' role at signup.
ADMIN_EMAIL=you@example.com

# Supabase service-role key — server-only, no NEXT_PUBLIC_ prefix. Bypasses RLS.
# Used only to promote the ADMIN_EMAIL account when it confirms its email
# (users can't change their own role). Locally: `npx supabase status` → service_role key.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
